# Elocutio reads API keys from the macOS Keychain in normal use, not from the
# environment. This file is for development and test harnesses only.
#
# Copy to .env.local (ignored by git) if you need local overrides.

# ELOCUTIO_LOG=info
# ELOCUTIO_OPENROUTER_KEY=
# ELOCUTIO_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ELOCUTIO_FAKE_PROVIDER_URL=http://127.0.0.1:8787
