{
  "version": 1,
  "name": "Elocutio",
  "tagline": "Your voice. Clearly expressed.",
  "color": {
    "ink-indigo": "#191F70",
    "soft-indigo": "#B8BEFF",
    "near-black": "#171717",
    "warm-paper": "#F8F7F3",
    "white": "#FFFFFF"
  },
  "typography": {
    "family": "Inter",
    "fallback": [
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "Roboto",
      "Helvetica Neue",
      "Arial",
      "sans-serif"
    ],
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "scale": {
      "caption": 11,
      "body": 13,
      "body-large": 15,
      "title": 20,
      "display": 32
    }
  },
  "space": [
    0,
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radius": {
    "control": 8,
    "card": 12,
    "panel": 16,
    "pill": 999
  },
  "logo": {
    "clearSpace": "2x eyebrow stroke thickness",
    "minimumMarkPx": 24,
    "minimumLockupPx": 140,
    "menuBarPx": 16
  },
  "semantic": {
    "accent": {
      "light": "#191F70",
      "dark": "#B8BEFF"
    },
    "surface": {
      "light": "#F8F7F3",
      "dark": "#171717"
    },
    "text": {
      "light": "#171717",
      "dark": "#F8F7F3"
    },
    "on-accent": {
      "light": "#FFFFFF",
      "dark": "#171717"
    }
  }
}
